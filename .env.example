# ---------------------------------------------------------------------------
# Pocket Mentor - environment configuration
# Copy this file to `.env` and adjust.  `npm start` reads it via src/config.js
# ---------------------------------------------------------------------------

# HTTP server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (SQLite file path, relative to the project root)
DB_PATH=./data/pocket_mentor.db

# Session secret used to sign the demo session token
SESSION_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# AI provider (OPTIONAL)
# The app ships with a deterministic on-device NLP engine ("local-engine") so
# it runs with ZERO external dependencies and zero API keys.
# Set AI_PROVIDER=openai (or anthropic) + AI_API_KEY to route summary /
# flashcard / quiz generation through a real LLM API instead.
# ---------------------------------------------------------------------------
AI_PROVIDER=local-engine
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Upload limits
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.txt,.md,.docx,.pdf
